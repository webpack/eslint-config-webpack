{
  "name": "eslint-config-webpack",
  "version": "5.0.2",
  "description": "Provides Webpack's eslint rules as an extensible shared config",
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "webpack",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/webpack/eslint-config-webpack#readme",
  "bugs": {
    "url": "https://github.com/webpack/eslint-config-webpack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webpack/eslint-config-webpack.git"
  },
  "license": "MIT",
  "author": "Joshua Wiens (https://twitter.com/@d3viant0ne)",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "plugins",
    "prettier-config.js",
    "prettier-config-es5.js",
    "configs.js",
    "ignore-paths.js",
    "configs"
  ],
  "scripts": {
    "lint": "npm run lint:code && npm run lint:types && npm run fmt:check",
    "lint:code": "eslint --cache .",
    "lint:types": "tsc -p tsconfig.internal.json",
    "fmt": "prettier --cache --write .",
    "fmt:check": "prettier --cache --check .",
    "test": "cd test && node --test",
    "rules:not-enabled": "node scripts/find-not-enabled-rules.js",
    "test:webpack": "node scripts/test-on-webpack.js",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint-community/regexpp": "^4.12.2",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "detect-indent": "^7.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-node-test": "^1.0.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "jsonc-eslint-parser": "^3.3.0",
    "semver": "^7.8.0",
    "sort-package-json": "^4.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@changesets/get-github-info": "^1.0.1",
    "@types/semver": "^7.8.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "type-fest": "^6.0.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "eslint": ">= 10.15.0",
    "typescript": ">=5.0.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.11.0 || >=24.0.0"
  }
}
